<?xml version="1.0" encoding="UTF-8"?>
<nsi>
  <!-- MBTools-DTS Windows installer (NSIS) -->

  <variables>
    <var name="ProductName" value="MBTools-DTS"/>
    <var name="ProductVersion" value="1.0.0"/>
    <var name="AppName" value="mbtools-dts"/>
    <var name="InstallDir" value="$PROGRAMFILES64\MBTools-DTS"/>
    <var name="OutputFile" value="mbtools-dts_setup.exe"/>
  </variables>

  <header>
    <vi-add-version-key>
      <productname>$var(ProductName)</productname>
      <companyname>MBTools-DTS Contributors</companyname>
      <filedescription>MBTools-DTS - open-source Mercedes-Benz diagnostics</filedescription>
      <productversion>$var(ProductVersion)</productversion>
      <legalcopyright>Copyright (C) 2026 MBTools-DTS Contributors</legalcopyright>
      <comments>Open-source Mercedes-Benz diagnostics combining mbtools, DT-Monaco and the PT3G J2534 driver.</comments>
    </vi-add-version-key>
    <unicode/>
    <!]>
      !include "MUI2.nsh"
      !define MUI_ABORTWARNING
      !define MUI_ICON "installer/mbtools-dts-icon.ico"
      !define MUI_UNICON "installer/mbtools-dts-icon.ico"
      !define MUI_HEADERIMAGE
    <![endif]>
  </header>

  <pages>
    <showinst>
      <name>Custom inst page</name>
    </showinst>
    <finish>
      <name>Custom finish page</name>
    </finish>
  </pages>

  <section id="main">
    <name>Install MBTools-DTS</name>
    <runasadmin/>
    <dirchoosedialog default="${InstallDir}" browseonley="yes"/>
    <regkeypath key="HKCU\Software\MBTools-DTS\InstallDir" name="InstallDir" type="string"/>
    <setoutpath value="$INSTALLDIR"/>
    <setregstrvalue key="HKCU\Software\MBTools-DTS" name="InstallDir" value="$INSTALLDIR"/>

    <files>
      <application file="$OUTDIR\mbtools-dts.exe" destination="$INSTALLDIR"/>
      <!-- bundled dependencies -->
      <directory recursive="yes" source="src\dist" destination="$INSTALLDIR"/>
      <directory recursive="yes" source="src\pythonlibs" destination="$INSTALLDIR\Libs"/>
    </files>

    <registrypage check="yes">
      <default>check</default>
    </registrypage>
  </section>

  <uninstall>
    <section id="uninst">
      <files>
        <application file="$OUTDIR\mbtools-dts.exe" destination="$INSTALLDIR"/>
      </files>
      <regupdate key="HKCU\Software\MBTools-DTS" value=""/>
    </section>
  </uninstall>

  <install>
    <section id="main">
      <createsymboliclink target="$INSTALLDIR\mbtools-dts.exe" name="$INSTDIR\mbtools-dts.exe"/>
    </section>
  </install>

  < uninstall>
    <section id="uninst">
      <rfinishinst/>
    </section>
  </uninstall>

  <!--
    The real entry-point scripts are generated by the package's pyproject.toml
    (console_scripts) and are installed to $INSTALLDIR\Scripts.  The NSIS script
    above only copies the PyInstaller bundle; the installer entry point is the
    `mbtools-dts.exe` output of the packaging step (see packaging/WIN_BUILD.md).
  -->
</nsi>
